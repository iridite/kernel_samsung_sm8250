# Droidian's kernel-snippet.mk auto-appends droidian/$(DEVICE_MODEL).config
# (gts7xlwifi) to the fragment chain. With Samsung's official kernel source
# (himekifee/drag-kernel-t975 halium-11.0 base), vendor/gts7xl_eur_open_defconfig
# already has all the device-specific options baked in. Keep this file as a
# placeholder so merge_config.sh finds it.
