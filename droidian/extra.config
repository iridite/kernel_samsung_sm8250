# Droidian + Halium kconfig fragment for Samsung Galaxy Tab S7+ (gts7xlwifi)
# Applied on top of: vendor/kona-perf_defconfig
#                  + vendor/samsung/kona-sec-common.config
#                  + vendor/samsung/gts7xlwifi.config
#
# Per docs.droidian.org/porting-guide/kernel-compilation/

# ── Core Droidian / glibc-userspace requirements ──
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_NAMESPACES=y
CONFIG_MODULES=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_INIT_STACK_ALL_ZERO=y

# Namespaces (explicit; usually pulled by NAMESPACES=y)
CONFIG_SYSVIPC=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# ── Halium / libhybris compat ──
# Disable Android paranoid network so Phosh / wpa_supplicant can use raw sockets
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# Keep classic binder, not BinderFS (libhybris talks to /dev/binder*)
# CONFIG_ANDROID_BINDERFS is not set

# ── USB gadgets — Halium tethering / USB modes ──
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_RMNET_BAM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# ── Bluetooth profile stack ──
CONFIG_BT=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HCIVHCI=y

# ── Waydroid (anbox-style binder + networking) ──
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
CONFIG_SW_SYNC_USER=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_VETH=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# ── Plymouth boot splash (framebuffer) ──
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FB_VIRTUAL=y

# ── Crash logging (useful during bring-up) ──
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_RAM_ANNOTATION_APPEND=y

# ── Inherited from ArchieMeng's original droidian/extra.config (Droidian basics) ──
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_BINFMT_MISC=y
CONFIG_POSIX_MQUEUE=y

# ── Kernel image size reduction ──
# Tab S7+ BOOT partition is 68 MB (smaller than pdx206's). With ArchieMeng's
# default config, the uncompressed Image lands at ~55 MB; together with the
# 16 MB Halium ramdisk and 1.4 MB DTB the boot.img totals 71 MB — 3 MB over.
# Disabling DEBUG_INFO, BTF, and aggressive kallsyms shaves ~5-10 MB off the
# Image so an uncompressed kernel still fits comfortably (Samsung ABL on
# this device doesn't accept gzip or lz4-compressed kernels — confirmed
# 2026-05-27 by flash-and-watch on hardware).
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_FRAME_POINTER is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# Note: CONFIG_FTRACE stays enabled — disabling it broke the build because
# kernel/bpf/bpf_lsm.o references tracing_prog_func_proto which is only
# defined when FTRACE provides it.
# CONFIG_KGDB is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_LOCKDEP is not set
# CONFIG_LOCK_STAT is not set

# ── TEMPORARY DEBUG — make boot faults observable (REMOVE once boot is fixed) ──
# The droidian-branch kernel reset-loops on first boot with nothing printed.
# Why it's silent: sec_debug's panic notifier (drivers/samsung/debug/sec_debug.c)
# calls __sec_debug_hw_reset() on ANY panic, ignoring panic_timeout; PANIC_ON_OOPS
# promotes every oops to a panic; and the QCOM apps watchdog resets on a hang.
# Disable all three so a fault becomes visible instead of insta-resetting: a panic
# hangs with its message on console=tty0, a hang just stalls (last line visible),
# or boot reaches the Halium RNDIS+telnet rescue (192.168.2.15) where dmesg has
# the full log. Re-enable PANIC_ON_OOPS/QCOM_WATCHDOG_V2 for production.
# NOTE: CONFIG_SEC_DEBUG must stay =y — the Samsung display driver
# (techpack/display .../ss_dsi_panel_debug.h struct lcd_debug_t) fails to build
# without it. The reset-on-panic is instead neutralised by a source patch to
# drivers/samsung/debug/sec_debug.c (skip __sec_debug_hw_reset in the panic
# notifier). With PANIC_ON_OOPS off, a recoverable driver oops also won't kill boot.
# NOTE: CONFIG_QCOM_WATCHDOG_V2 must ALSO stay =y — panic.c and sec_debug.c call
# emerg_pet_watchdog() unconditionally (undefined-reference link error if disabled).
# So a pure boot HANG can still be reset by the watchdog bite; if that happens we
# tackle the watchdog separately. Panics/oopses (the likely cause) are now visible.
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0

# ── Disable Bluetooth (TEMP for audio bring-up) ──
# Droidian's bluebinder opens an AF_BLUETOOTH/HCI socket at ~12s into boot and
# this LineageOS 4.19.325 kernel's bt_sock_create NULL-derefs → fatal panic
# (confirmed via /proc/last_kmsg: pc=bt_sock_create+0x134, x0=0). BT is not
# needed for audio; disable the whole stack so bluebinder's socket() just fails
# cleanly. Revisit proper BT bring-up (and the bt_sock_create bug) later.
# CONFIG_BT is not set
# NOTE: there is also a survivable IPA oops earlier (ipa_assert in
# ipa3_load_ipa_fw, ~10.6s) — harmless while PANIC_ON_OOPS is off; disable
# CONFIG_IPA3 too when hardening for production (re-enabling PANIC_ON_OOPS).
