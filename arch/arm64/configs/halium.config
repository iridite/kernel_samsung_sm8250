# halium.config — Ubuntu Touch kernel additions on top of the Droidian defconfig stack.
#
# Install: copy to  arch/arm64/configs/halium.config  in your kernel tree
#          (it is the last fragment in deviceinfo_kernel_defconfig).
#
# Most namespace/VT/devtmpfs options are ALREADY satisfied by droidian/extra.config;
# they are repeated here so this fragment alone matches UBports' check-kernel-config.

# --- Halium core requirements (UBports standalone_kernel_build doc) -----------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_UNIX98_PTYS=y

# --- AppArmor: REQUIRED by Ubuntu Touch; kona-perf_defconfig does NOT enable it --
# NB: the Android container still runs SELinux (androidboot.selinux=permissive in the
# cmdline). On this 4.19 kernel SELinux remains the active major LSM for the container;
# AppArmor is compiled in for the UT side. If UT app confinement must actually enforce,
# revisit LSM ordering / the `security=` boot param during bring-up.
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_AUDIT=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y

# --- libhybris needs classic binder device nodes (NOT binderfs) --------------
# Already handled in droidian/extra.config; left here as documentation:
# # CONFIG_ANDROID_BINDERFS is not set
# CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
