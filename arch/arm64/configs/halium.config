# halium.config — Ubuntu Touch kernel additions on top of the Droidian defconfig stack.
#
# Install: copy to  arch/arm64/configs/halium.config  in your kernel tree
#          (it is the last fragment in deviceinfo_kernel_defconfig).
#
# Most namespace/VT/devtmpfs options are ALREADY satisfied by droidian/extra.config;
# they are repeated here so this fragment alone matches UBports' check-kernel-config.

# --- Halium core requirements (UBports standalone_kernel_build doc) -----------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_UNIX98_PTYS=y

# --- AppArmor: REQUIRED by Ubuntu Touch; kona-perf_defconfig does NOT enable it --
# NB: the Android container still runs SELinux (androidboot.selinux=permissive in the
# cmdline). On this 4.19 kernel SELinux remains the active major LSM for the container;
# AppArmor is compiled in for the UT side. If UT app confinement must actually enforce,
# revisit LSM ordering / the `security=` boot param during bring-up.
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_AUDIT=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y

# --- Binder: UBports' mount-android-partitions REQUIRES binderfs --------------
# It runs `mount -t binder binder /dev/binderfs` with NO fallback. The base
# kona-perf_defconfig sets BINDERFS=y, but the inherited droidian/extra.config
# (= halium-extra.config) DISABLES it ("# CONFIG_ANDROID_BINDERFS is not set") because
# DROIDIAN uses classic multi-device binder for Waydroid (anbox-binder,...). Ubuntu Touch
# does NOT run Waydroid and its container wants binderfs. Re-enable it here: halium.config
# is the LAST fragment in deviceinfo_kernel_defconfig, so this overrides halium-extra.config
# (merge_config = last-wins). Without binderfs the Android container never starts:
#   mount: /dev/binderfs: unknown filesystem type 'binder'  → mount-android-partitions exits 32
#   → lxc-android-config dependency fails → container STOPPED → no hwcomposer HAL
#   → Mir android2 priority 0 "Failed to find platform" → lightdm loops 5x → black screen.
# Confirmed on-device 2026-06-05 (ut-debug.log: container State: STOPPED, test_hwcomposer
# assertion err==0 fails, getprop returns 0 lines).
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
